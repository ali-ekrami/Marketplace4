@model IEnumerable<tagr.Models.ApplicationUser>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Manage Users";
}

<div class="container mt-4">
    <h2>User Management Table</h2>
    <hr />

    <table class="table table-bordered table-striped mt-3">
        <thead class="table-dark">
            <tr>
                <th>Full Name</th>
                <th>Email</th>
                <th>Account Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>
                        @if (user.IsSuspended)
                        {
                            <span class="badge bg-danger"> Suspended</span>
                        }
                        else
                        {
                            <span class="badge bg-success"> Active</span>
                        }
                    </td>
                    <td>
                        <form asp-area="Admin" asp-controller="Users" asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="d-inline">
                            @if (user.IsSuspended)
                            {
                                <button type="submit" class="btn btn-sm btn-outline-success">Activate Account</button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-outline-danger">Suspend Account</button>
                            }
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>