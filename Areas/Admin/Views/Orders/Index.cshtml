@model IEnumerable<tagr.ViewModels.UserAdminListItemViewModel>
@{
    ViewData["Title"] = "Manage Users";
    var users = Model.ToList();
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">User Management</h1>
            <p class="text-muted mb-0">
                View and manage all registered accounts
            </p>
        </div>
        <span class="badge bg-primary-subtle text-primary fs-6 px-3 py-2">
            @users.Count User@(users.Count == 1 ? "" : "s")
        </span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!users.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <h5 class="mb-1">No users found</h5>
                <p class="text-muted mb-0">There are no registered accounts yet.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">User</th>
                            <th>Email</th>
                            <th>Seller Status</th>
                            <th>Account Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in users)
                        {
                            var initials = string.Concat(
                                (user.FullName ?? "?")
                                    .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                    .Take(2)
                                    .Select(n => char.ToUpper(n[0])));

                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle bg-secondary-subtle text-secondary-emphasis d-flex align-items-center justify-content-center fw-bold"
                                             style="width:40px;height:40px;font-size:0.85rem;flex-shrink:0;">
                                            @initials
                                        </div>
                                        <div class="fw-semibold">
                                            @user.FullName
                                        </div>
                                    </div>
                                </td>

                                <td class="text-muted">
                                    @user.Email
                                </td>

                                <td>
                                    @if (user.IsSellerApproved)
                                    {
                                        <span class="badge rounded-pill bg-info-subtle text-info-emphasis border border-info-subtle">
                                            Approved Seller
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">
                                            Not a Seller
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (user.IsSuspended)
                                    {
                                        <span class="badge rounded-pill bg-danger-subtle text-danger-emphasis border border-danger-subtle">
                                            &#9679; Suspended
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-success-subtle text-success-emphasis border border-success-subtle">
                                            &#9679; Active
                                        </span>
                                    }
                                </td>

                                <td class="text-end pe-4">
                                    <form asp-area="Admin"
                                          asp-controller="Users"
                                          asp-action="ToggleStatus"
                                          asp-route-id="@user.Id"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()

                                        @if (user.IsSuspended)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                Activate
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Suspend @user.FullName\'s account?');">
                                                Suspend
                                            </button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>
