@model tagr.ViewModels.ProductDetailsViewModel

@{
    ViewData["Title"] = "Delete Product";
}

<div class="container min-vh-100 d-flex align-items-center justify-content-center py-5">

    <div class="col-12 col-md-8 col-lg-6">

        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-body p-4 p-md-5">

                <!-- Header -->
                <div class="text-center mb-4">

                    <div class="d-inline-flex align-items-center justify-content-center
                        bg-danger-subtle text-danger rounded-circle mb-3"
                         style="width: 64px; height: 64px;">

                        <i class="bi bi-trash3 fs-3"></i>

                    </div>

                    <h3 class="fw-bold mb-1">
                        Delete Product
                    </h3>

                    <p class="text-muted mb-0">
                        This action cannot be undone.
                    </p>

                </div>


                <!-- Warning -->
                <div class="alert alert-danger rounded-3 mb-4">

                    <i class="bi bi-exclamation-triangle-fill me-2"></i>

                    Are you sure you want to delete this product?

                </div>


                <!-- Product Information -->
                <div class="bg-light rounded-4 p-4 mb-4">

                    <div class="d-flex align-items-center gap-3 mb-3">

                        <div class="d-flex align-items-center
                            justify-content-center
                            bg-white rounded-3 border"
                             style="width: 48px; height: 48px;">

                            <i class="bi bi-box-seam text-muted fs-5"></i>

                        </div>

                        <div>

                            <div class="text-muted small">
                                Product
                            </div>

                            <div class="fw-bold">
                                @Model.Name
                            </div>

                        </div>

                    </div>


                    <hr class="my-3">


                    <div class="row g-3">

                        <!-- Category -->
                        <div class="col-sm-6">

                            <div class="text-muted small mb-1">
                                Category
                            </div>

                            <div class="fw-semibold">
                                <i class="bi bi-folder2 me-1 text-muted"></i>
                                @Model.CategoryName
                            </div>

                        </div>


                        <!-- Price -->
                        <div class="col-sm-6">

                            <div class="text-muted small mb-1">
                                Price
                            </div>

                            <div class="fw-bold">
                                @Model.Price.ToString("C")
                            </div>

                        </div>


                        <!-- Quantity -->
                        <div class="col-sm-6">

                            <div class="text-muted small mb-1">
                                Stock Quantity
                            </div>

                            <div class="fw-semibold">
                                <i class="bi bi-boxes me-1 text-muted"></i>
                                @Model.StockQuantity
                            </div>

                        </div>

                    </div>

                </div>


                <!-- Actions -->
                <form asp-action="Delete"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           asp-for="Id" />

                    <div class="d-grid gap-2">

                        <button type="submit"
                                class="btn btn-danger btn-lg fw-semibold">

                            <i class="bi bi-trash3 me-2"></i>
                            Yes, Delete Product

                        </button>

                        <a asp-action="MyProducts"
                           class="btn btn-light">

                            <i class="bi bi-arrow-left me-2"></i>
                            Back to My Products

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>