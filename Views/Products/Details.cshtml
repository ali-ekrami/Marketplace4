@model tagr.ViewModels.ProductDetailsViewModel

@{
    ViewData["Title"] = "Product Details";
}

<div class="container py-5">

    <div class="mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary">
            &larr; Back to Products
        </a>
    </div>

    <div class="row g-5">

        <!-- Product Image -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0">

                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         class="card-img-top"
                         alt="@Model.Name"
                         style="height: 450px; object-fit: cover;" />
                }
                else
                {
                    <div class="bg-light d-flex align-items-center justify-content-center"
                         style="height: 450px;">
                        <span class="text-muted fs-5">No Image Available</span>
                    </div>
                }

            </div>
        </div>

        <!-- Product Information -->
        <div class="col-md-6">

            <div class="mb-3">
                <span class="badge bg-secondary">
                    @Model.CategoryName
                </span>
            </div>

            <h1 class="display-5 fw-bold mb-3">
                @Model.Name
            </h1>

            <div class="mb-4">
                <span class="display-6 fw-bold text-primary">
                    @Model.Price.ToString("C")
                </span>
            </div>

            <hr />

            <h5 class="fw-bold mt-4">Description</h5>
            <p class="text-muted">
                @Model.Description
            </p>

            <div class="row mt-4">
                <div class="col-sm-6 mb-3">
                    <div class="border rounded p-3">
                        <small class="text-muted d-block">Seller</small>
                        <span class="fw-bold">
                            @Model.SellerName
                        </span>
                    </div>
                </div>
            </div>

            @if (Model.StockQuantity > 0)
            {
                <form asp-controller="Cart" asp-action="Add" method="post" class="mt-4">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="productId" value="@Model.Id" />

                    <div class="mb-3">
                        <label for="quantity" class="form-label fw-bold">Quantity</label>
                        <input type="number"
                               id="quantity"
                               name="quantity"
                               value="1"
                               min="1"
                               max="@Model.StockQuantity"
                               class="form-control"
                               style="max-width: 200px;" />
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100">
                        Add to Cart
                    </button>

                </form>
            }
            else
            {
                <button type="button" class="btn btn-secondary btn-lg w-100 mt-4" disabled>
                    Out of Stock
                </button>
            }

        </div>

    </div>

</div>