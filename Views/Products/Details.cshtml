@model tagr.ViewModels.ProductDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
    var fullStars = (int)Math.Round(Model.AverageRating);
}

<div class="container py-4">

    <nav class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left"></i> Back to Products
        </a>
    </nav>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-5">

        <!-- Product Image -->
        <div class="col-lg-6">
            <div class="rounded-4 overflow-hidden border bg-white position-relative">

                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         alt="@Model.Name"
                         class="w-100"
                         style="height: 480px; object-fit: cover;" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center bg-light"
                         style="height: 480px;">
                        <span class="text-muted">No Image Available</span>
                    </div>
                }

                @if (Model.StockQuantity <= 0)
                {
                    <span class="position-absolute top-0 start-0 m-3 badge bg-dark bg-opacity-75 px-3 py-2">
                        Out of Stock
                    </span>
                }
                else if (Model.StockQuantity <= 5)
                {
                    <span class="position-absolute top-0 start-0 m-3 badge bg-danger px-3 py-2">
                        Only @Model.StockQuantity left
                    </span>
                }
            </div>
        </div>

        <!-- Product Information -->
        <div class="col-lg-6">

            <a asp-action="Index" asp-route-categoryId="" class="badge bg-primary-subtle text-primary text-decoration-none mb-3 d-inline-block px-3 py-2">
                @Model.CategoryName
            </a>

            <h1 class="fw-bold mb-2" style="font-size: 2rem;">
                @Model.Name
            </h1>

            <div class="d-flex align-items-center gap-2 mb-3">
                <div class="text-warning">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <i class="bi @(i <= fullStars ? "bi-star-fill" : "bi-star")"></i>
                    }
                </div>
                <span class="text-muted small">
                    @Model.AverageRating.ToString("0.0")
                    (@Model.ReviewsCount review@(Model.ReviewsCount == 1 ? "" : "s"))
                </span>
            </div>

            <div class="mb-4">
                <span class="fw-bold text-dark" style="font-size: 2.25rem;">
                    @Model.Price.ToString("C")
                </span>
            </div>

            <p class="text-muted mb-4" style="line-height: 1.7;">
                @Model.Description
            </p>

            <div class="d-flex align-items-center gap-3 p-3 rounded-3 bg-light mb-4">
                <div class="rounded-circle bg-white border d-flex align-items-center justify-content-center"
                     style="width:44px;height:44px;flex-shrink:0;">
                    <i class="bi bi-shop text-muted"></i>
                </div>
                <div>
                    <div class="text-muted small">Sold by</div>
                    <div class="fw-semibold">@Model.SellerName</div>
                </div>
            </div>

            @if (Model.StockQuantity > 0)
            {
                <form asp-controller="Cart" asp-action="Add" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.Id" />

                    <div class="d-flex gap-3 align-items-end">
                        <div>
                            <label for="quantity" class="form-label small fw-semibold text-muted">Quantity</label>
                            <input type="number"
                                   id="quantity"
                                   name="quantity"
                                   value="1"
                                   min="1"
                                   max="@Model.StockQuantity"
                                   class="form-control"
                                   style="width: 100px;" />
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg flex-grow-1">
                            <i class="bi bi-cart-plus"></i>
                            Add to Cart
                        </button>
                    </div>
                </form>
            }
            else
            {
                <button type="button" class="btn btn-secondary btn-lg w-100" disabled>
                    Out of Stock
                </button>
            }

        </div>

    </div>

</div>
