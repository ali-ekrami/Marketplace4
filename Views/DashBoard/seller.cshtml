@{
    ViewData["Title"] = "Seller Dashboard";
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">
            Seller Dashboard
        </h1>

        <p class="text-muted mb-0">
            Manage your products and orders.
        </p>
    </div>

    <!-- Statistics -->
    <div class="row g-4 mb-4">

        <!-- Products -->
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <div class="text-muted small">
                                My Products
                            </div>

                            <div class="fs-3 fw-bold">
                                @ViewBag.TotalProducts
                            </div>
                        </div>

                        <div class="bg-primary-subtle text-primary rounded-3 p-3">
                            <i class="bi bi-box-seam fs-4"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>


        <!-- Orders -->
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <div class="text-muted small">
                                Orders
                            </div>

                            <div class="fs-3 fw-bold">
                                @ViewBag.TotalOrders
                            </div>
                        </div>

                        <div class="bg-success-subtle text-success rounded-3 p-3">
                            <i class="bi bi-cart-check fs-4"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>


        <!-- Pending Orders -->
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <div class="text-muted small">
                                Pending Orders
                            </div>

                            <div class="fs-3 fw-bold">
                                @ViewBag.PendingOrders
                            </div>
                        </div>

                        <div class="bg-warning-subtle text-warning rounded-3 p-3">
                            <i class="bi bi-clock fs-4"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>


        <!-- Sales -->
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <div class="text-muted small">
                                My Sales
                            </div>

                            <div class="fs-3 fw-bold">
                                @ViewBag.TotalSales.ToString("C")
                            </div>
                        </div>

                        <div class="bg-info-subtle text-info rounded-3 p-3">
                            <i class="bi bi-currency-dollar fs-4"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>

    </div>


    <!-- Quick Actions -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">
            <h5 class="fw-bold mb-0">
                Quick Actions
            </h5>
        </div>

        <div class="card-body">

            <div class="row g-3">

                <!-- My Products -->
                <div class="col-md-4">
                    <a asp-controller="Products"
                       asp-action="MyProducts"
                       class="btn btn-outline-primary w-100 py-3">

                        <i class="bi bi-box-seam me-2"></i>
                        My Products

                    </a>
                </div>


                <!-- Add Product -->
                <div class="col-md-4">
                    <a asp-controller="Products"
                       asp-action="Create"
                       class="btn btn-outline-success w-100 py-3">

                        <i class="bi bi-plus-circle me-2"></i>
                        Add Product

                    </a>
                </div>


                <!-- Orders -->
                <div class="col-md-4">
                    <a asp-controller="SellerOrders"
                       asp-action="Index"
                       class="btn btn-outline-secondary w-100 py-3">

                        <i class="bi bi-cart-check me-2"></i>
                        My Orders

                    </a>
                </div>

            </div>

        </div>

    </div>

</div>
