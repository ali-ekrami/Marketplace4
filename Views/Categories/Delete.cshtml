@model tagr.ViewModels.CategoryDeleteViewModel

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container min-vh-100 d-flex align-items-center justify-content-center py-5">

    <div class="col-12 col-sm-10 col-md-7 col-lg-5">

        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-body p-4 p-md-5">

                <!-- Header -->
                <div class="text-center mb-4">

                    <div class="d-inline-flex align-items-center justify-content-center
                        bg-danger-subtle text-danger rounded-circle mb-3"
                         style="width: 64px; height: 64px;">

                        <i class="bi bi-trash3 fs-3"></i>

                    </div>

                    <h3 class="fw-bold mb-1">
                        Delete Category
                    </h3>

                    <p class="text-muted mb-0">
                        This action cannot be undone.
                    </p>

                </div>

                <!-- Category -->
                <div class="bg-light rounded-3 p-3 mb-4 text-center">

                    <span class="text-muted small d-block mb-1">
                        Category
                    </span>

                    <span class="fw-bold fs-5">
                        @Model.Name
                    </span>

                </div>

                @if (Model.ProductsCount > 0)
                {
                    <!-- Cannot Delete -->
                    <div class="alert alert-warning rounded-3">

                        <div class="d-flex gap-2">

                            <i class="bi bi-exclamation-triangle-fill"></i>

                            <div>
                                This category contains
                                <strong>@Model.ProductsCount</strong>
                                product(s).

                                <div class="small mt-1">
                                    Move the products to another category
                                    before deleting this category.
                                </div>
                            </div>

                        </div>

                    </div>

                    <a asp-action="Index"
                       class="btn btn-light w-100">

                        <i class="bi bi-arrow-left me-2"></i>
                        Back to Categories

                    </a>
                }
                else
                {
                    <!-- Confirmation -->
                    <div class="alert alert-danger rounded-3 mb-4">

                        <i class="bi bi-exclamation-circle me-2"></i>

                        Are you sure you want to delete this category?

                    </div>

                    <form asp-action="Delete"
                          method="post">

                        <input type="hidden"
                               asp-for="Id" />

                        <div class="d-grid gap-2">

                            <button type="submit"
                                    class="btn btn-danger btn-lg fw-semibold">

                                <i class="bi bi-trash3 me-2"></i>
                                Yes, Delete

                            </button>

                            <a asp-action="Index"
                               class="btn btn-light">

                                <i class="bi bi-arrow-left me-2"></i>
                                Cancel

                            </a>

                        </div>

                    </form>
                }

            </div>
        </div>

    </div>

</div>