@model tagr.ViewModels.OrderDetailsViewModel

@{
    ViewData["Title"] = $"Order #{Model.Id}";

    var badgeClass = Model.Status switch
    {
        tagr.Models.OrderStatus.Pending => "bg-warning-subtle text-warning-emphasis border-warning-subtle",
        tagr.Models.OrderStatus.Confirmed => "bg-info-subtle text-info-emphasis border-info-subtle",
        tagr.Models.OrderStatus.Shipped => "bg-primary-subtle text-primary-emphasis border-primary-subtle",
        tagr.Models.OrderStatus.Delivered => "bg-success-subtle text-success-emphasis border-success-subtle",
        tagr.Models.OrderStatus.Cancelled => "bg-danger-subtle text-danger-emphasis border-danger-subtle",
        _ => "bg-secondary-subtle text-secondary-emphasis border-secondary-subtle"
    };
}

<div class="container py-4">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 fw-bold mb-1">Order #@Model.Id</h1>
                    <p class="text-muted mb-0">
                        Placed on @Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt")
                    </p>
                </div>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Back to My Orders
                </a>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small mb-1">Status</div>
                        <span class="badge rounded-pill border fs-6 @badgeClass">
                            @Model.Status
                        </span>
                    </div>
                    <div class="text-end">
                        <div class="text-muted small mb-1">Total Amount</div>
                        <div class="fs-4 fw-bold">@Model.TotalAmount.ToString("C")</div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-semibold mb-3">Shipping Details</h6>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="text-muted small mb-1">Phone Number</div>
                            <div class="fw-semibold">@Model.PhoneNumber</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted small mb-1">Address</div>
                            <div class="fw-semibold">@Model.ShippingAddress</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-semibold">Order Items</h6>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Product</th>
                                <th class="text-center">Quantity</th>
                                <th class="text-end">Unit Price</th>
                                <th class="text-end pe-4">Line Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-4">@item.ProductName</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end">@item.UnitPrice.ToString("C")</td>
                                    <td class="text-end pe-4 fw-semibold">@item.LineTotal.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-light">
                                <td colspan="3" class="text-end fw-bold pe-3">Total</td>
                                <td class="text-end pe-4 fw-bold">@Model.TotalAmount.ToString("C")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

        </div>
    </div>

</div>
