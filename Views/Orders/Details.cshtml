@model tagr.ViewModels.OrderDetailsViewModel

@{
    ViewData["Title"] = $"Order #{Model.Id}";

    var badgeClass = Model.Status switch
    {
        tagr.Models.OrderStatus.Pending =>
            "bg-warning-subtle text-warning-emphasis border-warning-subtle",

        tagr.Models.OrderStatus.Confirmed =>
            "bg-info-subtle text-info-emphasis border-info-subtle",

        tagr.Models.OrderStatus.Shipped =>
            "bg-primary-subtle text-primary-emphasis border-primary-subtle",

        tagr.Models.OrderStatus.Delivered =>
            "bg-success-subtle text-success-emphasis border-success-subtle",

        tagr.Models.OrderStatus.Cancelled =>
            "bg-danger-subtle text-danger-emphasis border-danger-subtle",

        _ =>
            "bg-secondary-subtle text-secondary-emphasis border-secondary-subtle"
    };
}

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-md-center
        gap-3 mb-4">

        <div>

            <div class="d-flex align-items-center gap-2 mb-1">

                <h1 class="h3 fw-bold mb-0">
                    Order #@Model.Id
                </h1>

                <span class="badge rounded-pill border @badgeClass">
                    @Model.Status
                </span>

            </div>

            <p class="text-muted mb-0">
                Placed on @Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt")
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-light">

            <i class="bi bi-arrow-left me-2"></i>
            Back to My Orders

        </a>

    </div>


    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3"
             role="alert">

            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Order Overview -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body p-4">

            <div class="row g-4 align-items-center">

                <!-- Status -->
                <div class="col-md-6">

                    <div class="d-flex align-items-center gap-3">

                        <div class="d-flex align-items-center
                            justify-content-center
                            bg-light rounded-circle"
                             style="width: 52px; height: 52px;">

                            <i class="bi bi-box-seam fs-4 text-primary"></i>

                        </div>

                        <div>

                            <div class="text-muted small">
                                Order Status
                            </div>

                            <span class="badge rounded-pill border @badgeClass mt-1">
                                @Model.Status
                            </span>

                        </div>

                    </div>

                </div>


                <!-- Total -->
                <div class="col-md-6">

                    <div class="d-flex align-items-center
                        justify-content-md-end gap-3">

                        <div class="d-flex align-items-center
                            justify-content-center
                            bg-light rounded-circle"
                             style="width: 52px; height: 52px;">

                            <i class="bi bi-currency-dollar fs-4 text-primary"></i>

                        </div>

                        <div class="text-md-end">

                            <div class="text-muted small">
                                Total Amount
                            </div>

                            <div class="fw-bold fs-4">
                                @Model.TotalAmount.ToString("C")
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Cancel -->
        @if (Model.CanCancel)
        {
            <div class="card-footer bg-white border-top p-3 text-end">

                <form asp-action="Cancel"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <button type="submit"
                            class="btn btn-outline-danger"
                            onclick="return confirm('Cancel this order? The items will be returned to stock.');">

                        <i class="bi bi-x-circle me-2"></i>
                        Cancel Order

                    </button>

                </form>

            </div>
        }

    </div>


    <!-- Shipping Details -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body p-4">

            <div class="d-flex align-items-center gap-2 mb-4">

                <div class="d-flex align-items-center
                    justify-content-center
                    bg-primary-subtle text-primary
                    rounded-3"
                     style="width: 42px; height: 42px;">

                    <i class="bi bi-truck"></i>

                </div>

                <div>

                    <h5 class="fw-bold mb-0">
                        Shipping Details
                    </h5>

                    <small class="text-muted">
                        Delivery information
                    </small>

                </div>

            </div>


            <div class="row g-4">

                <div class="col-md-6">

                    <div class="text-muted small mb-1">
                        Phone Number
                    </div>

                    <div class="fw-semibold">
                        <i class="bi bi-telephone me-2 text-muted"></i>
                        @Model.PhoneNumber
                    </div>

                </div>


                <div class="col-md-6">

                    <div class="text-muted small mb-1">
                        Shipping Address
                    </div>

                    <div class="fw-semibold">
                        <i class="bi bi-geo-alt me-2 text-muted"></i>
                        @Model.ShippingAddress
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Order Items -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="card-body p-4 border-bottom">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">
                        Order Items
                    </h5>

                    <small class="text-muted">
                        Products included in this order
                    </small>

                </div>

                <span class="badge bg-light text-dark border">
                    @Model.Items.Count item(s)
                </span>

            </div>

        </div>


        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th class="ps-4 py-3">
                            Product
                        </th>

                        <th class="text-center py-3">
                            Quantity
                        </th>

                        <th class="text-end py-3">
                            Unit Price
                        </th>

                        <th class="text-end pe-4 py-3">
                            Total
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var item in Model.Items)
                    {
                        <tr>

                            <td class="ps-4">

                                <div class="d-flex align-items-center gap-3">

                                    <div class="d-flex align-items-center
                                        justify-content-center
                                        bg-light rounded-3"
                                         style="width: 44px; height: 44px;">

                                        <i class="bi bi-box text-muted"></i>

                                    </div>

                                    <span class="fw-semibold">
                                        @item.ProductName
                                    </span>

                                </div>

                            </td>


                            <td class="text-center">

                                <span class="badge bg-light text-dark border">
                                    × @item.Quantity
                                </span>

                            </td>


                            <td class="text-end text-muted">
                                @item.UnitPrice.ToString("C")
                            </td>


                            <td class="text-end pe-4 fw-semibold">
                                @item.LineTotal.ToString("C")
                            </td>

                        </tr>
                    }

                </tbody>


                <tfoot>

                    <tr class="table-light">

                        <td colspan="3"
                            class="text-end fw-bold py-3">

                            Total

                        </td>

                        <td class="text-end pe-4 fw-bold fs-5">

                            @Model.TotalAmount.ToString("C")

                        </td>

                    </tr>

                </tfoot>

            </table>

        </div>

    </div>

</div>