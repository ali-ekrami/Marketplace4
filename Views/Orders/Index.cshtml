@model List<tagr.ViewModels.OrderListItemViewModel>

@{
    ViewData["Title"] = "My Orders";
}

<div class="container py-5">

    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">
            My Orders
        </h1>

        <p class="text-muted mb-0">
            Track and review your past orders.
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3"
             role="alert">

            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-body text-center py-5">

                <div class="d-inline-flex align-items-center justify-content-center
                    bg-light text-muted rounded-circle mb-3"
                     style="width: 72px; height: 72px;">

                    <i class="bi bi-receipt fs-2"></i>

                </div>

                <h5 class="fw-bold mb-2">
                    No orders yet
                </h5>

                <p class="text-muted mb-4">
                    You haven't placed any orders yet.
                </p>

                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-primary px-4">

                    <i class="bi bi-shop me-2"></i>
                    Browse Products

                </a>

            </div>

        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th class="ps-4 py-3">Order</th>
                                <th class="py-3">Date</th>
                                <th class="py-3">Items</th>
                                <th class="py-3">Total</th>
                                <th class="py-3">Status</th>
                                <th class="text-end pe-4 py-3">Actions</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var order in Model)
                            {
                                var badgeClass = order.Status switch
                                {
                                    tagr.Models.OrderStatus.Pending =>
                                        "bg-warning-subtle text-warning-emphasis border-warning-subtle",

                                    tagr.Models.OrderStatus.Confirmed =>
                                        "bg-info-subtle text-info-emphasis border-info-subtle",

                                    tagr.Models.OrderStatus.Shipped =>
                                        "bg-primary-subtle text-primary-emphasis border-primary-subtle",

                                    tagr.Models.OrderStatus.Delivered =>
                                        "bg-success-subtle text-success-emphasis border-success-subtle",

                                    tagr.Models.OrderStatus.Cancelled =>
                                        "bg-danger-subtle text-danger-emphasis border-danger-subtle",

                                    _ =>
                                        "bg-secondary-subtle text-secondary-emphasis border-secondary-subtle"
                                };

                                <tr>

                                    <td class="ps-4">

                                        <div class="d-flex align-items-center gap-3">

                                            <div class="d-flex align-items-center
                                                justify-content-center
                                                bg-primary-subtle text-primary
                                                rounded-3"
                                                 style="width: 42px; height: 42px;">

                                                <i class="bi bi-receipt"></i>

                                            </div>

                                            <span class="fw-semibold">
                                                #@order.Id
                                            </span>

                                        </div>

                                    </td>

                                    <td>

                                        <div class="fw-semibold small">
                                            @order.OrderDate.ToString("dd MMM yyyy")
                                        </div>

                                        <div class="text-muted small">
                                            @order.OrderDate.ToString("hh:mm tt")
                                        </div>

                                    </td>

                                    <td>

                                        <span class="badge bg-light text-dark border">

                                            @order.ItemsCount
                                            @(order.ItemsCount == 1
                                                ? "item"
                                                : "items")

                                        </span>

                                    </td>

                                    <td>

                                        <span class="fw-bold">
                                            @order.TotalAmount.ToString("C")
                                        </span>

                                    </td>

                                    <td>

                                        <span class="badge rounded-pill border @badgeClass">
                                            @order.Status
                                        </span>

                                    </td>

                                    <td class="text-end pe-4">

                                        <div class="d-inline-flex gap-2">

                                            <a asp-action="Details"
                                               asp-route-id="@order.Id"
                                               class="btn btn-sm btn-outline-primary">

                                                <i class="bi bi-eye me-1"></i>
                                                Details

                                            </a>

                                            @if (order.CanCancel)
                                            {
                                                <form asp-action="Cancel"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@order.Id" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            onclick="return confirm('Cancel order #@order.Id?');">

                                                        <i class="bi bi-x-circle me-1"></i>
                                                        Cancel

                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>