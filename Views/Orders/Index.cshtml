@model List<tagr.ViewModels.OrderListItemViewModel>

@{
    ViewData["Title"] = "My Orders";
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">My Orders</h1>
        <p class="text-muted mb-0">
            Track and review your past orders
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <h5 class="mb-2">No orders yet</h5>
                <p class="text-muted mb-3">You haven't placed any orders yet.</p>
                <a asp-controller="Products" asp-action="Index" class="btn btn-primary">
                    Browse Products
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Order #</th>
                            <th>Date</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">#@order.Id</td>
                                <td>@order.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                <td>@order.ItemsCount item@(order.ItemsCount == 1 ? "" : "s")</td>
                                <td class="fw-bold">@order.TotalAmount.ToString("C")</td>
                                <td>
                                    @{
                                        var badgeClass = order.Status switch
                                        {
                                            tagr.Models.OrderStatus.Pending => "bg-warning-subtle text-warning-emphasis border-warning-subtle",
                                            tagr.Models.OrderStatus.Confirmed => "bg-info-subtle text-info-emphasis border-info-subtle",
                                            tagr.Models.OrderStatus.Shipped => "bg-primary-subtle text-primary-emphasis border-primary-subtle",
                                            tagr.Models.OrderStatus.Delivered => "bg-success-subtle text-success-emphasis border-success-subtle",
                                            tagr.Models.OrderStatus.Cancelled => "bg-danger-subtle text-danger-emphasis border-danger-subtle",
                                            _ => "bg-secondary-subtle text-secondary-emphasis border-secondary-subtle"
                                        };
                                    }
                                    <span class="badge rounded-pill border @badgeClass">
                                        @order.Status
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary">
                                        View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>
