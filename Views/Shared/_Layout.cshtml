



<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - TAGR</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/tagr.styles.css"
          asp-append-version="true" />

</head>


<body>

    <!-- ================= NAVBAR ================= -->

    <header>

        <nav class="navbar navbar-expand-lg tagr-navbar">

            <div class="container-fluid px-lg-5">

                <!-- LOGO -->

                <a class="navbar-brand tagr-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <i class="bi bi-bag-heart-fill"></i>
                    TAGR

                </a>


                <!-- MOBILE BUTTON -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#tagrNavbar">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="collapse navbar-collapse"
                     id="tagrNavbar">


                    <!-- LEFT LINKS -->

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">


                        <!-- HOME -->

                        <li class="nav-item">

                            <a class="nav-link tagr-nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>


                        <!-- PRODUCTS -->

                        <li class="nav-item">

                            <a class="nav-link tagr-nav-link"
                               asp-controller="Products"
                               asp-action="Index">

                                Products

                            </a>

                        </li>


                        <!-- CATEGORIES -->
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">

                                <a class="nav-link tagr-nav-link"
                                   asp-controller="Categories"
                                   asp-action="Index">

                                    Categories

                                </a>

                            </li>
                        }


                        <!-- CART -->
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">

                                <a class="nav-link tagr-nav-link"
                                   asp-controller="Cart"
                                   asp-action="Index">

                                    <i class="bi bi-cart3"></i>
                                    My Cart

                                </a>

                            </li>
                        }


                        <!-- WISHLIST -->
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">

                                <a class="nav-link tagr-nav-link"
                                   asp-controller="Wishlist"
                                   asp-action="Index">

                                    <i class="bi bi-heart"></i>
                                    Wishlist

                                </a>

                            </li>
                        }


                        <!-- ORDERS -->
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">

                                <a class="nav-link tagr-nav-link"
                                   asp-controller="Orders"
                                   asp-action="Index">

                                    <i class="bi bi-box-seam"></i>
                                    My Orders

                                </a>

                            </li>
                        }


                        <!-- SELLER -->
                        @if (User.IsInRole("Seller"))
                        {
                            <li class="nav-item">

                                <a class="nav-link tagr-nav-link"
                                   asp-controller="Dashboard"
                                   asp-action="seller">

                                    <i class="bi bi-speedometer2"></i>
                                    Dashboard

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link tagr-nav-link"
                                   asp-controller="Products"
                                   asp-action="MyProducts">

                                    My Products

                                </a>

                            </li>
                        }


                        <!-- ADMIN -->
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">

                                <a class="nav-link tagr-nav-link"
                                   asp-controller="Dashboard"
                                   asp-action="Index">

                                    <i class="bi bi-speedometer2"></i>
                                    Dashboard

                                </a>

                            </li>
                        }

                    </ul>


                    <!-- LOGIN PARTIAL -->

                    <div class="d-flex align-items-center">

                        <partial name="_LoginPartial" />

                    </div>

                </div>

            </div>

        </nav>

    </header>


    <!-- ================= MAIN ================= -->

    <main>

        @RenderBody()

    </main>


    <!-- ================= FOOTER ================= -->

    <footer class="tagr-footer">

        <div class="container-fluid">

            <div class="row align-items-center">

                <div class="col-md-4">

                    <div class="footer-brand">

                        <i class="bi bi-bag-heart-fill"></i>
                        TAGR

                    </div>

                    <p class="footer-description">

                        Your trusted online marketplace.

                    </p>

                </div>


                <div class="col-md-4">

                    <div class="footer-links">

                        <a asp-controller="Products"
                           asp-action="Index">

                            Products

                        </a>

                        <a asp-controller="Products"
                           asp-action="Index">

                            Categories

                        </a>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Orders"
                               asp-action="Index">

                                My Orders

                            </a>
                        }

                        <a asp-controller="Home"
                           asp-action="Privacy">

                            Privacy

                        </a>

                    </div>

                </div>


                <div class="col-md-4 text-md-end">

                    <div class="d-flex gap-2 justify-content-md-end">

                        <span class="footer-social">
                            <i class="bi bi-facebook"></i>
                        </span>

                        <span class="footer-social">
                            <i class="bi bi-instagram"></i>
                        </span>

                        <span class="footer-social">
                            <i class="bi bi-twitter-x"></i>
                        </span>

                    </div>

                </div>

            </div>


            <div class="footer-bottom">

                © 2026 TAGR. All rights reserved.

            </div>

        </div>

    </footer>


    <!-- SCRIPTS -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>