@using Microsoft.AspNetCore.Identity
@using tagr.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<ul class="navbar-nav align-items-center">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <span class="nav-link text-dark">
                <i class="bi bi-person-circle"></i>
                Hello @User.Identity?.Name!
            </span>
        </li>
        @if (!User.IsInRole("Seller") && !User.IsInRole("Admin"))
        {
            <li class="nav-item">
                <a class="nav-link text-success fw-bold" asp-area="" asp-controller="Seller" asp-action="Become">
                    Become a Seller
                </a>
            </li>
        }
        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item">
                <a class="nav-link text-primary fw-bold" asp-area="Admin" asp-controller="Users" asp-action="Index">
                    Manage Users
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link text-warning fw-bold" asp-area="Admin" asp-controller="Sellers" asp-action="Requests">
                    Seller Requests
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link text-primary fw-bold" asp-area="Admin" asp-controller="Orders" asp-action="Index">
                    All Orders
                </a>
            </li>
        }
        <li class="nav-item ms-2">
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-box-arrow-right"></i>
                    Logout
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item me-2">
            <a class="btn btn-outline-primary btn-sm" asp-controller="Account" asp-action="Register">
                Create New Account
            </a>
        </li>
        <li class="nav-item">
            <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Login">
                Login
            </a>
        </li>
    }
</ul>