@model List<tagr.ViewModels.SellerOrderListItemViewModel>
@using tagr.Models

@{
    ViewData["Title"] = "Orders on My Products";

    var totalOrders = Model.Count;
    var pendingOrders = Model.Count(x => x.Status == OrderStatus.Pending);
    var totalSales = Model.Sum(x => x.MyItemsTotal);
}

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <h1 class="h3 fw-bold mb-1">
                Orders on My Products
            </h1>

            <p class="text-muted mb-0">
                Manage orders containing your products
            </p>
        </div>

        <a asp-controller="Products"
           asp-action="MyProducts"
           class="btn btn-outline-secondary">
            <i class="bi bi-box-seam me-1"></i>
            My Products
        </a>

    </div>


    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (!Model.Any())
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <div class="d-inline-flex align-items-center justify-content-center
                    rounded-circle bg-light text-muted mb-3"
                     style="width:72px;height:72px;">

                    <i class="bi bi-bag-x fs-2"></i>

                </div>

                <h5 class="fw-bold mb-2">
                    No Orders Yet
                </h5>

                <p class="text-muted mb-4">
                    None of your products has been ordered so far.
                </p>

                <a asp-controller="Products"
                   asp-action="MyProducts"
                   class="btn btn-primary">

                    <i class="bi bi-box-seam me-1"></i>
                    View My Products

                </a>

            </div>

        </div>
    }
    else
    {
        <!-- Statistics -->
        <div class="row g-3 mb-4">

            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>
                                <div class="text-muted small mb-1">
                                    Total Orders
                                </div>

                                <div class="fs-3 fw-bold">
                                    @totalOrders
                                </div>
                            </div>

                            <div class="d-flex align-items-center justify-content-center
                                rounded-circle bg-primary-subtle text-primary"
                                 style="width:50px;height:50px;">

                                <i class="bi bi-bag fs-5"></i>

                            </div>

                        </div>

                    </div>
                </div>

            </div>


            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>
                                <div class="text-muted small mb-1">
                                    Pending Orders
                                </div>

                                <div class="fs-3 fw-bold">
                                    @pendingOrders
                                </div>
                            </div>

                            <div class="d-flex align-items-center justify-content-center
                                rounded-circle bg-warning-subtle text-warning"
                                 style="width:50px;height:50px;">

                                <i class="bi bi-clock-history fs-5"></i>

                            </div>

                        </div>

                    </div>
                </div>

            </div>


            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>
                                <div class="text-muted small mb-1">
                                    My Sales
                                </div>

                                <div class="fs-3 fw-bold">
                                    @totalSales.ToString("C")
                                </div>
                            </div>

                            <div class="d-flex align-items-center justify-content-center
                                rounded-circle bg-success-subtle text-success"
                                 style="width:50px;height:50px;">

                                <i class="bi bi-currency-dollar fs-5"></i>

                            </div>

                        </div>

                    </div>
                </div>

            </div>

        </div>


        <!-- Orders Table -->
        <div class="card border-0 shadow-sm">

            <div class="card-header bg-white border-0 py-3">

                <div class="d-flex justify-content-between align-items-center">

                    <h6 class="mb-0 fw-bold">
                        Recent Orders
                    </h6>

                    <span class="text-muted small">
                        @totalOrders order@(totalOrders == 1 ? "" : "s")
                    </span>

                </div>

            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-4">
                                Order
                            </th>

                            <th>
                                Date
                            </th>

                            <th>
                                Customer
                            </th>

                            <th class="text-center">
                                My Items
                            </th>

                            <th class="text-end">
                                My Total
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-end pe-4">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var order in Model)
                        {
                            var badgeClass = order.Status switch
                            {
                                OrderStatus.Pending =>
                                    "bg-warning-subtle text-warning-emphasis border-warning-subtle",

                                OrderStatus.Confirmed =>
                                    "bg-info-subtle text-info-emphasis border-info-subtle",

                                OrderStatus.Shipped =>
                                    "bg-primary-subtle text-primary-emphasis border-primary-subtle",

                                OrderStatus.Delivered =>
                                    "bg-success-subtle text-success-emphasis border-success-subtle",

                                OrderStatus.Cancelled =>
                                    "bg-danger-subtle text-danger-emphasis border-danger-subtle",

                                _ =>
                                    "bg-secondary-subtle text-secondary-emphasis border-secondary-subtle"
                            };

                            var statusIcon = order.Status switch
                            {
                                OrderStatus.Pending => "bi-hourglass-split",
                                OrderStatus.Confirmed => "bi-check-circle",
                                OrderStatus.Shipped => "bi-truck",
                                OrderStatus.Delivered => "bi-box-seam",
                                OrderStatus.Cancelled => "bi-x-circle",
                                _ => "bi-question-circle"
                            };

                            <tr>

                                <!-- Order -->
                                <td class="ps-4">

                                    <div class="fw-bold">
                                        #@order.Id
                                    </div>

                                    <small class="text-muted">
                                        Order
                                    </small>

                                </td>


                                <!-- Date -->
                                <td>

                                    <div class="fw-semibold">
                                        @order.OrderDate.ToString("dd MMM yyyy")
                                    </div>

                                    <small class="text-muted">
                                        @order.OrderDate.ToString("hh:mm tt")
                                    </small>

                                </td>


                                <!-- Customer -->
                                <td>

                                    <div class="d-flex align-items-center gap-2">

                                        <div class="d-flex align-items-center justify-content-center
                                            rounded-circle bg-light text-muted"
                                             style="width:38px;height:38px;">

                                            <i class="bi bi-person"></i>

                                        </div>

                                        <span class="fw-semibold">
                                            @order.CustomerName
                                        </span>

                                    </div>

                                </td>


                                <!-- Items -->
                                <td class="text-center">

                                    <span class="badge bg-light text-dark border">
                                        @order.MyItemsCount
                                        item@(order.MyItemsCount == 1 ? "" : "s")
                                    </span>

                                </td>


                                <!-- Total -->
                                <td class="text-end">

                                    <span class="fw-bold">
                                        @order.MyItemsTotal.ToString("C")
                                    </span>

                                </td>


                                <!-- Status -->
                                <td>

                                    <span class="badge rounded-pill border px-3 py-2 @badgeClass">

                                        <i class="bi @statusIcon me-1"></i>

                                        @order.Status

                                    </span>

                                </td>


                                <!-- Actions -->
                                <td class="text-end pe-4">

                                    <a asp-action="Details"
                                       asp-route-id="@order.Id"
                                       class="btn btn-sm btn-outline-primary">

                                        <i class="bi bi-eye me-1"></i>
                                        Details

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>