@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container my-5">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="d-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-3"
                     style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-shield-halved fs-4"></i>
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-1">Privacy Policy</h1>
                    <p class="text-muted mb-0">Your privacy and data security are our top priorities.</p>
                </div>
            </div>

            <hr class="my-4">

            <div class="privacy-content">
                <h5 class="fw-bold mb-3">1. Information We Collect</h5>
                <p class="text-muted mb-4">
                    When you use TAGR Marketplace, we collect information you provide directly to us when creating an account,
                    listing products, placing orders, or communicating with customer support.
                </p>

                <h5 class="fw-bold mb-3">2. How We Protect Your Data</h5>
                <p class="text-muted mb-4">
                    We employ industry-standard encryption protocols and secure escrow workflows to safeguard all transactions
                    and customer identity records across our marketplace ecosystem.
                </p>

                <h5 class="fw-bold mb-3">3. Contact Us</h5>
                <p class="text-muted mb-0">
                    If you have questions or concerns about this Privacy Policy, please contact our support team at
                    <a href="mailto:support@tagr.marketplace" class="text-primary fw-semibold">support@tagr.marketplace</a>.
                </p>
            </div>
        </div>
    </div>
</div>
