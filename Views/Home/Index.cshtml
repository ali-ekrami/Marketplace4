@model List<tagr.ViewModels.ProductListItemViewModel>

@{
    ViewData["Title"] = "Home - Next-Gen 3D Marketplace";
}

<div class="home-page">

    <!-- =========================================================
         1. 100% FULL-WIDTH EDGE-TO-EDGE 3D HERO BANNER
         Touches Navbar seamlessly with ZERO top/left/right margins
         ========================================================= -->
    <section class="tagr-hero-wrapper" id="heroWrapper">

        <!-- Ambient Floating Glowing Orbs -->
        <div class="tagr-hero-orb orb-1" id="heroOrb1"></div>
        <div class="tagr-hero-orb orb-2" id="heroOrb2"></div>

        <div class="tagr-hero-grid">

            <!-- Hero Left Content -->
            <div class="tagr-hero-content" id="heroContent">

                <span class="tagr-hero-badge">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                    Next-Gen 3D Marketplace
                </span>

                <h1 class="tagr-hero-title">
                    Discover Something
                    <span class="tagr-text-gradient">Extraordinary.</span>
                </h1>

                <p class="tagr-hero-subtitle">
                    Explore curated, authentic collections from verified merchants. Enjoy instant digital checkout, 
                    secure escrow buyer protection, and next-day express delivery.
                </p>

                <!-- Interactive 3D Search Bar -->
                <form class="tagr-3d-search"
                      asp-area=""
                      asp-controller="Products"
                      asp-action="Index"
                      method="get">

                    <i class="fa-solid fa-magnifying-glass text-muted fs-5"></i>

                    <input type="text"
                           name="searchString"
                           placeholder="Search across 10,000+ premium products..."
                           aria-label="Search products" />

                    <button type="submit" class="tagr-search-submit">
                        <span>Search</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>

                </form>

                <!-- Trust Metrics -->
                <div class="tagr-hero-metrics">

                    <div class="tagr-metric-item">
                        <span class="tagr-metric-value">10K+</span>
                        <span class="tagr-metric-label">Curated Items</span>
                    </div>

                    <div class="tagr-metric-item">
                        <span class="tagr-metric-value">100%</span>
                        <span class="tagr-metric-label">Verified Sellers</span>
                    </div>

                    <div class="tagr-metric-item">
                        <span class="tagr-metric-value">4.9 ★</span>
                        <span class="tagr-metric-label">Buyer Rating</span>
                    </div>

                    <div class="tagr-metric-item">
                        <span class="tagr-metric-value">24/7</span>
                        <span class="tagr-metric-label">Escrow Support</span>
                    </div>

                </div>

            </div>


            <!-- Hero Right 3D Visual Showcase (Scroll-Driven 3D Transform) -->
            <div class="tagr-hero-3d-visual">

                <!-- Floating Satellite Chip 1: Verified Protection -->
                <div class="tagr-floating-chip chip-verified" id="heroChip1">
                    <div class="tagr-chip-icon chip-emerald">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <div>
                        <strong class="d-block small text-main fw-bold">Escrow Protected</strong>
                        <small class="text-muted" style="font-size: 0.72rem;">100% Safe Payments</small>
                    </div>
                </div>

                <!-- Main 3D Floating Showcase Card -->
                <div class="tagr-hero-card-main" id="heroScrollCard" data-tilt>

                    <span class="tagr-hero-card-badge">
                        <i class="fa-solid fa-bolt me-1"></i>Trending Today
                    </span>

                    <div class="tagr-hero-card-img-wrap">
                        <i class="fa-solid fa-headphones-simple"></i>
                    </div>

                    <h4 class="tagr-hero-card-title">Spatial Pro Studio Edition</h4>
                    <p class="text-muted small mb-3">Ultra-low latency wireless acoustic engineering</p>

                    <div class="tagr-hero-card-meta">
                        <div>
                            <small class="text-muted d-block" style="font-size: 0.72rem;">Special Price</small>
                            <span class="tagr-hero-card-price">$289.00</span>
                        </div>

                        <a asp-area=""
                           asp-controller="Products"
                           asp-action="Index"
                           class="btn btn-sm tagr-btn-primary px-3">
                            <span>Explore</span>
                            <i class="fa-solid fa-arrow-right ms-1"></i>
                        </a>
                    </div>

                </div>

                <!-- Floating Satellite Chip 2: Flash Offer -->
                <div class="tagr-floating-chip chip-offer" id="heroChip2">
                    <div class="tagr-chip-icon chip-amber">
                        <i class="fa-solid fa-tag"></i>
                    </div>
                    <div>
                        <strong class="d-block small text-main fw-bold">Flash Deals</strong>
                        <small class="text-muted" style="font-size: 0.72rem;">Up to 35% Discount</small>
                    </div>
                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         2. REST OF HOME PAGE IN STANDARD BOOTSTRAP CONTAINER
         Uses the EXACT SAME container margins and padding as all other pages
         ========================================================= -->
    <div class="container my-5">

        <!-- =========================================================
             SECTION: SHOP BY CATEGORY (3D SCROLL-REVEAL TILES)
             ========================================================= -->
        <section class="section-container mb-5" data-scroll-3d>

            <div class="section-header mb-4">

                <div>
                    <span class="section-line"></span>
                    <h2>Shop by Category</h2>
                </div>

                <a asp-area=""
                   asp-controller="Products"
                   asp-action="Index"
                   class="tagr-view-all-link">
                    <span>View All Categories</span>
                    <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>

            </div>


            <div class="category-grid">

                <a asp-area=""
                   asp-controller="Products"
                   asp-action="Index"
                   asp-route-categoryId="1"
                   class="category-card category-indigo tagr-scroll-card"
                   data-tilt>

                    <div class="category-icon">
                        <i class="fa-solid fa-laptop"></i>
                    </div>

                    <h3>Electronics</h3>
                    <span>Smart Devices & Tech</span>

                </a>


                <a asp-area=""
                   asp-controller="Products"
                   asp-action="Index"
                   asp-route-categoryId="2"
                   class="category-card category-rose tagr-scroll-card"
                   data-tilt>

                    <div class="category-icon">
                        <i class="fa-solid fa-shirt"></i>
                    </div>

                    <h3>Fashion</h3>
                    <span>Apparel & Modern Wear</span>

                </a>


                <a asp-area=""
                   asp-controller="Products"
                   asp-action="Index"
                   asp-route-categoryId="3"
                   class="category-card category-violet tagr-scroll-card"
                   data-tilt>

                    <div class="category-icon">
                        <i class="fa-solid fa-book-open"></i>
                    </div>

                    <h3>Books</h3>
                    <span>Knowledge & Media</span>

                </a>


                <a asp-area=""
                   asp-controller="Products"
                   asp-action="Index"
                   asp-route-categoryId="4"
                   class="category-card category-emerald tagr-scroll-card"
                   data-tilt>

                    <div class="category-icon">
                        <i class="fa-solid fa-couch"></i>
                    </div>

                    <h3>Home & Living</h3>
                    <span>Interior & Comfort</span>

                </a>


                <a asp-area=""
                   asp-controller="Products"
                   asp-action="Index"
                   asp-route-categoryId="5"
                   class="category-card category-amber tagr-scroll-card"
                   data-tilt>

                    <div class="category-icon">
                        <i class="fa-solid fa-dumbbell"></i>
                    </div>

                    <h3>Sports & Fitness</h3>
                    <span>Performance Gear</span>

                </a>


                <a asp-area=""
                   asp-controller="Products"
                   asp-action="Index"
                   asp-route-categoryId="6"
                   class="category-card category-cyan tagr-scroll-card"
                   data-tilt>

                    <div class="category-icon">
                        <i class="fa-solid fa-gamepad"></i>
                    </div>

                    <h3>Toys & Gaming</h3>
                    <span>Entertainment & Fun</span>

                </a>

            </div>

        </section>


        <!-- =========================================================
             SECTION: FEATURED PRODUCTS SHOWCASE (3D SCROLL CASCADE)
             ========================================================= -->
        <section class="section-container products-section my-5" data-scroll-3d>

            <div class="section-header mb-4">

                <div>
                    <span class="section-line"></span>
                    <h2>Featured Products</h2>
                </div>

                <a asp-area=""
                   asp-controller="Products"
                   asp-action="Index"
                   class="tagr-view-all-link">
                    <span>View Full Catalog</span>
                    <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>

            </div>


            <div class="product-grid">

                @foreach (var product in Model)
                {
                    <div class="product-card tagr-scroll-card" data-tilt>

                        <div class="product-image">

                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl"
                                     alt="@product.Name"
                                     class="product-main-image" />
                            }
                            else
                            {
                                <div class="no-product-image text-muted d-flex align-items-center justify-content-center h-100 fs-1">
                                    <i class="fa-solid fa-image"></i>
                                </div>
                            }

                            @if (product.StockQuantity > 0)
                            {
                                <span class="badge position-absolute top-0 start-0 m-3"
                                      style="background: var(--tagr-secondary); color: white; font-size: 0.7rem; font-weight: 700; border-radius: 20px; padding: 5px 10px;">
                                    In Stock
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger position-absolute top-0 start-0 m-3"
                                      style="font-size: 0.7rem; font-weight: 700; border-radius: 20px; padding: 5px 10px;">
                                    Sold Out
                                </span>
                            }

                            <button class="wishlist-btn" type="button" aria-label="Add to Wishlist" title="Save to Wishlist">
                                <i class="fa-regular fa-heart"></i>
                            </button>

                        </div>

                        <div class="product-info">

                            <span class="product-category">
                                @product.CategoryName
                            </span>

                            <h3>@product.Name</h3>

                            <div class="rating">
                                ★★★★★
                            </div>

                            <div class="product-bottom">

                                <strong>
                                    $@product.Price.ToString("N2")
                                </strong>

                                <a asp-area=""
                                   asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@product.Id"
                                   class="add-cart-btn">

                                    <i class="fa-solid fa-eye me-1"></i>
                                    <span>Details</span>

                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>

        </section>


        <!-- =========================================================
             SECTION: VALUE PILLARS (WHY CHOOSE TAGR)
             ========================================================= -->
        <section class="features-section my-5" data-scroll-3d>

            <div class="feature-item tagr-scroll-card" data-tilt>

                <div class="feature-icon">
                    <i class="fa-solid fa-truck-fast"></i>
                </div>

                <div>
                    <h3>Next-Day Dispatch</h3>
                    <p>Tracked and insured delivery straight to your doorstep.</p>
                </div>

            </div>


            <div class="feature-item tagr-scroll-card" data-tilt>

                <div class="feature-icon">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>

                <div>
                    <h3>Verified Merchants</h3>
                    <p>Every seller is KYC-verified with escrow payment release.</p>
                </div>

            </div>


            <div class="feature-item tagr-scroll-card" data-tilt>

                <div class="feature-icon">
                    <i class="fa-solid fa-star"></i>
                </div>

                <div>
                    <h3>Real Buyer Reviews</h3>
                    <p>Authentic feedback from verified past buyers only.</p>
                </div>

            </div>

        </section>

    </div>

</div>
